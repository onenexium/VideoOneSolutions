{
  "expo": {
    "name": "Onenexium",
    "slug": "ott-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "scheme": "onenexium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.onenexium.ott",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Access to the local network is required to discover screen mirroring devices (Cast / AirPlay) and, in development, to reach the debug server.",
        "NSBonjourServices": [
          "_airplay._tcp",
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp",
          "_expo._tcp"
        ]
      },
      "appleTeamId": "L5HCL383AF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.onenexium.ott",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "update": {
      "assetPatternsToBeBundled": [
        "**/*"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withGoogleCast",
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da3dba2a-7410-4326-a093-3127addcb01f"
      }
    },
    "owner": "ott-onenexiums-team"
  }
}
